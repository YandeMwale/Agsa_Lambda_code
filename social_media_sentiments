REGION = os.getenv("AWS_REGION", "af-south-1")
OUTPUT_BUCKET = os.getenv("INPUT_BUCKET", "agsa-dev-source-bucket-970103398702")
TAVILY_API_KEY = os.getenv("TAVILY_API_KEY", "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")

# Query parameters (defaults per issue request)
QUERY = os.getenv(
    "QUERY",
    "Social media posts and public discussions about corruption, fraud, bribery, financial crimes, and civil misconduct involving ONLY South African government officials, South African politicians and South African public servants."
)
INCLUDE_ANSWER = os.getenv("INCLUDE_ANSWER", "advanced")
